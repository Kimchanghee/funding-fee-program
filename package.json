{
  "name": "funding-fee-program",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/prepare-standalone.js",
    "start": "node scripts/start-standalone.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --update-env",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 delete funding-fee-watchdog && pm2 delete funding-fee-program",
    "pm2:save": "pm2 save",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "evaluate:exchanges": "npx tsx scripts/evaluate-exchanges.ts",
    "report:trade-audit": "npx tsx scripts/generate-trade-audit-report.ts"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ccxt": "^4.4.70",
    "zustand": "^5.0.3",
    "lucide-react": "^0.468.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.13",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4"
  }
}

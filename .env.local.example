# This app stores API keys in browser localStorage (client-side only)
# No server-side env vars needed for API keys

# Optional: for future server-side features
# NEXT_PUBLIC_APP_NAME=펀딩피 헷징
# SITE_PASSWORD=9788

# AWS deployment
# NEXT_PUBLIC_API_URL=https://your-domain.com

# --- Internal API auth (used by watchdog -> server) ---
# Both should equal SITE_PASSWORD when running locally; otherwise the
# watchdog will see 401 from the protected /api routes.
# INTERNAL_API_TOKEN=9788
# WATCHDOG_INTERNAL_API_TOKEN=9788

# --- Guard relaxation feature flags (default OFF) ---
# Backed by the 2026-04-30 outage backtest (scenario D = B+C). Both flags
# are read fresh every scheduler tick so `pm2 reload --update-env` flips
# behaviour without a redeploy. Roll back by removing/setting false.
#
# B: bumps live funding-time drift tolerance from 1m to 10m AND accepts
#    1h/4h/8h cross-interval shifts.
# RELAX_FUNDING_WINDOW=false
#
# C: on orderbook fetch failure during execute, retries with 500/1000/2000ms
#    backoff and, if still failing, defers the entry to the next funding
#    cycle (logs `deferred_to_next_cycle`) instead of failing terminally.
# ORDERBOOK_DEFER_ENABLED=false
